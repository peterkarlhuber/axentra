# Only pyproject.toml, the docs files named in the Dockerfile, src/, deploy/locks, deploy/sbom.py and
# deploy/constraints.txt (Taskboard image) are needed for the images. Keep secrets, local state and caches out of the build context.
.git
.github
.venv*
**/__pycache__
**/*.py[cod]
*.egg-info
.mypy_cache
.ruff_cache
.pytest_cache
.coverage
coverage.xml
test-results.xml
dist
build
var
tests
docs
openapi
assets
node_modules
.env
**/.env
*.local.toml
deploy/compose
deploy/config
Dockerfile
.dockerignore
# examples/taskboard/Dockerfile needs only examples/taskboard/{pyproject.toml,taskboard/}.
examples/*/tests
examples/**/var
examples/common
examples/multi-product
examples/single-product
