# Copy to deploy/compose/.env and fill in. Never commit .env (it is git- and docker-ignored).
# Generate values with:
#   openssl rand -hex 24                       (database passwords; keep them URL-safe)
#   docker run --rm axentra:local keys generate --kid k1   (encryption keyring entry)

# PostgreSQL superuser of the database container (only used by the image's init scripts).
POSTGRES_PASSWORD=change-me-superuser
# Owner role: owns the schema, runs migrations.
AXENTRA_DB_OWNER_PASSWORD=change-me-owner
# Application role used by the API at runtime (no superuser, no BYPASSRLS).
AXENTRA_DB_APP_PASSWORD=change-me-app

# Versioned keyring kid:base64key[,kid2:base64key]; the first key encrypts, all decrypt.
# BACK THIS UP separately from database dumps; without it encrypted values cannot be restored.
AXENTRA_MASTER_KEYS=k1:replace-with-output-of-axentra-keys-generate

# "production" requires an https public URL and https origins (TLS terminated by your proxy).
# "development" allows plain http on localhost for a local trial.
AXENTRA_ENVIRONMENT=development
AXENTRA_PUBLIC_URL=http://localhost:8080
# JSON list of browser origins allowed to call the API with cookies (product frontend, Studio).
AXENTRA_ALLOWED_ORIGINS=["http://localhost:5173"]
# Host port the API is published on.
AXENTRA_HTTP_PORT=8080

# Taskboard demo stack only (docker-compose.taskboard.yml): its browser origin and host port.
TASKBOARD_ORIGIN=http://localhost:8090
TASKBOARD_HTTP_PORT=8090
